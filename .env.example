# =====================================================
# 生产环境密钥模板 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿入库）
# 生成强随机值示例：
#   JWT_SECRET: openssl rand -base64 48
#   SM4_KEY:    openssl rand -hex 16   (16 字节 = 32 个 hex 字符)
#   数据库口令:  自定义强口令
# =====================================================

# MySQL
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password
MYSQL_PASSWORD=change-me-to-a-strong-app-password

# JWT 签名密钥（HS256，建议 ≥ 32 字节随机串）
JWT_SECRET=change-me-to-a-random-long-secret-at-least-32-bytes

# 国密 SM4 密钥（16 字节，以 hex 表示 = 32 字符）
SM4_KEY=00000000000000000000000000000000
